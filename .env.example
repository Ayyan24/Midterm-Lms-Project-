PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/edulearn_lms?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_min_32_chars_long_key_midterm_2026
OTP_SECRET=your_otp_secret_min_32_chars_long_key_midterm_2026

# SMTP Email Configuration (Nodemailer Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
MAIL_FROM=your_email@gmail.com

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
